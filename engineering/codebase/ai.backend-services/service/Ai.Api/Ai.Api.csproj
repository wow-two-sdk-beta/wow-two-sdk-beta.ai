<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The deployable Ai service: hosts the Form 1 module with the model providers and adds only hosting, the `ai` operator
    verbs (the eval bench), the HTTP mirror of the contract and the hosted pages. It takes the domain's own packages by
    ProjectReference, never by a published version. Provider keys stay out of the repo: user-secrets on the local bench
    (dotnet user-secrets set "Ai:Providers:anthropic:ApiKey" …), the target's settings when deployed.
  -->
  <PropertyGroup>
    <UserSecretsId>wow2-ai-api-7f1c2d4e-5b8a-4c61-9e3f-a0d2b6c1e4f7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Module\WoW.Two.Sdk.Beta.Be.Ai.Module.csproj" />
    <ProjectReference Include="..\..\packages\Providers\WoW.Two.Sdk.Beta.Be.Ai.Providers.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- ai.frontend-services (the pnpm workspace) is a sibling of ai.backend-services under engineering/codebase/. -->
    <SpaRoot>$(MSBuildProjectDirectory)/../../../ai.frontend-services/</SpaRoot>
    <SpaEnabled Condition="'$(BuildSpa)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">true</SpaEnabled>
  </PropertyGroup>
  <!-- Reinstalls packages only when the lockfile changed since the last install. -->
  <Target Name="RestoreSpa" Condition="'$(SpaEnabled)' == 'true'"
          Inputs="$(SpaRoot)pnpm-lock.yaml" Outputs="$(SpaRoot)node_modules/.modules.yaml">
    <Error Condition="!Exists('$(SpaRoot)package.json')" Text="SpaRoot must point to the frontend workspace." />
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" />
  </Target>
  <!-- Builds the workspace (fe-ai, then apps/web) into wwwroot, so one build yields the host that serves API + pages. -->
  <Target Name="BuildSpa" DependsOnTargets="RestoreSpa" BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets"
          Condition="'$(SpaEnabled)' == 'true'">
    <Exec Command="pnpm run deploy" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <Content Remove="@(Content)"
               Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('wwwroot/'))" />
      <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
