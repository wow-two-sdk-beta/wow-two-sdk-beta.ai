<Project>

  <!--
    Central Package Management — one version per package for the whole solution; project files name packages only.
    The family's own packages arrive by ProjectReference, never by version. core-latest.yml overrides
    BackendSdkVersion with the newest published be sdk (-p:BackendSdkVersion=…) to catch drift nightly.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The core pin; it is also each package's nuspec floor on WoW2.Sdk.Beta.Be and the kernel. -->
    <BackendSdkVersion>10.0.111-beta</BackendSdkVersion>
  </PropertyGroup>

  <!--
    Security pins on transitive packages, until the be sdk raises its own dependency (GHSA-wr8v-9x5q-ggcm on
    Microsoft.AspNetCore.SignalR.StackExchangeRedis 10.0.3, 2026-11-12). Each pin lists the patched version; drop it once
    BackendSdkVersion brings that version or newer.
  -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
  </ItemGroup>

  <!-- be sdk: one family, bumped together. The kernel (Result, AppError, IEvent) is the only package the contract takes. -->
  <ItemGroup>
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Abstractions" Version="$(BackendSdkVersion)" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be" Version="$(BackendSdkVersion)" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing" Version="$(BackendSdkVersion)" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing.Data" Version="$(BackendSdkVersion)" />
  </ItemGroup>

  <!--
    AI providers (packages/Providers). Microsoft.Extensions.AI 10.8.3 and OllamaSharp 5.5.0 arrive with the be sdk;
    Microsoft.Extensions.AI.OpenAI 10.8.3 pairs with that line and requires OpenAI 2.12.0; Anthropic needs
    Microsoft.Extensions.AI.Abstractions >= 10.5.1.
  -->
  <ItemGroup Label="AI providers">
    <PackageVersion Include="Anthropic" Version="13.8.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
  </ItemGroup>

  <!-- Tests. -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
